# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Database (choose Firebase OR Supabase) ────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# -- OR Supabase --
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── FastAPI ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# Optional generated draft; reports default to grounded transcript excerpts.
ENABLE_ABSTRACTIVE_SUMMARY=false

# Semantic meeting extraction through Groq. Never place this key in VITE_*.
GROQ_API_KEY=
MEETING_LLM_BASE_URL=https://api.groq.com/openai/v1
MEETING_LLM_MODEL=openai/gpt-oss-120b
MEETING_LLM_RESPONSE_FORMAT=json_schema
# Conservative input budgeting includes instructions, schema and output reserve.
MEETING_LLM_CONTEXT_TOKENS=32768
MEETING_LLM_MAX_OUTPUT_TOKENS=8192
MEETING_LLM_TIMEOUT_SECONDS=120

# Separate payload ceiling for provider throughput limits (UTF-8 bytes).
MEETING_LLM_MAX_INPUT_BYTES=8192
# GPT-OSS reasoning tokens also consume the provider throughput quota.
MEETING_LLM_REASONING_EFFORT=low
# Compact findings need merge room; they do not repeat the full transcript.
MEETING_LLM_SYNTHESIS_BYTES=12288
